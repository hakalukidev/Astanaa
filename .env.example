# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── PostgreSQL (server-only) — Firebase migration, see the plan at
# ~/.claude/plans/abstract-cooking-walrus.md ──────────────────────────────
# In production this points at the Postgres instance running on the same
# VPS as the app (localhost) — see the `astanaa`/`astanaa_app` setup done
# directly on the VPS. Never put the real password here or in .env.local
# if either file might be shared/screenshotted; keep it only in the actual
# environment files on each machine.
DATABASE_URL="postgresql://astanaa_app:REPLACE_ME@localhost:5432/astanaa?schema=public"

# One-time Phase-6 password migration only — lets old Firebase-Auth
# accounts log in once against their original scrypt hash, then get
# transparently upgraded to argon2 (see lib/auth/password.ts).
# Get these 4 values from: Firebase Console -> Authentication -> Users ->
# the "Password Hash Parameters" option in the menu near "Add user".
FIREBASE_SCRYPT_SIGNER_KEY=
FIREBASE_SCRYPT_SALT_SEPARATOR=
FIREBASE_SCRYPT_ROUNDS=
FIREBASE_SCRYPT_MEM_COST=

# ── Firebase (client SDK) ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Sign in with Google (server-only) ──────────────────────────────────
# Google Cloud Console → Google Auth Platform → Clients → "Astanaa Web".
# Its Authorized redirect URIs must include <site>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Image uploads — stored on the VPS disk, served by nginx at /uploads/ ──
# Leave unset in local dev (falls back to public/uploads).
UPLOADS_DIR=/var/www/astanaa-uploads

# ── Firebase Admin SDK (server-only) — dynamic admin login + user mgmt ──
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Copy client_email and private_key from the downloaded JSON.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ── SMS OTP — BD SMS gateway (server-only) ─────────────────────────────
# Defaults to BulkSMSBD's simple HTTP API (bulksmsbd.net). Sign up there,
# recharge balance, and copy the API key from your dashboard. If you use a
# different gateway (SSL Wireless, Alpha SMS...), just change SMS_API_URL
# and adjust the request in lib/sms.ts to match that provider's params.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=http://bulksmsbd.net/api/smsapi
# If unset (no account yet), OTP codes are logged to the server console
# instead of being sent — useful for testing before you sign up.

# ── Email OTP — Resend (server-only) ────────────────────────────────────
# Sign up at resend.com, verify a sending domain (or use their onboarding@
# resend.dev sandbox address while testing), and copy the API key.
RESEND_API_KEY=
EMAIL_FROM="Astanaa.com <onboarding@resend.dev>"

# ── OTP signing secret (server-only) ─────────────────────────────────────
# Any long random string. Used to hash OTP codes.
# Generate one with: openssl rand -hex 32
OTP_SIGNING_SECRET=

# ── Cloudflare Turnstile — captcha on signup/forgot-password (public + server) ──
# Register a Turnstile widget for your domain at
# dash.cloudflare.com → Turnstile → Add site, then copy its Site Key
# (public, shown to visitors) and Secret Key (server-only, verifies the
# token they solve). If unset, Cloudflare's published "always passes" test
# keys are used automatically in dev so the widget still renders and works
# locally — this never falls back in production, so set real keys before
# going live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
