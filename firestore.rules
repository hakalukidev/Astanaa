rules_version = '2';

// Covers every collection the client SDK touches directly: the apartment
// marketplace (listings, users, chats, buyRequests, admins-read) plus the
// catalog collections written straight from the admin panel via
// lib/product-service.ts, lib/category-service.ts and lib/slide-service.ts
// (products, categories, slides — publicly readable, staff-admin writable).
// Blog posts go through app/api/admin/blog/* (Firebase Admin SDK, server
// side), so they don't need client rules here.
//
// Deploy with: firebase deploy --only firestore:rules
// (requires `firebase init` / a firebase.json pointing at this file first)
// — or paste this whole file into Firebase Console → Firestore → Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasAdminAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // admin / super_admin: full catalog control + can activate boosts.
    function isStaffAdmin() {
      return hasAdminAccount() &&
        (adminDoc().data.role == 'super_admin' || adminDoc().data.role == 'admin');
    }

    // super_admin, admin, and moderator can all approve/reject/remove listings.
    function canModerateListings() {
      return hasAdminAccount() && adminDoc().data.role in ['super_admin', 'admin', 'moderator'];
    }

    // --- admins ------------------------------------------------------------
    // Only used so a signed-in user can check their own admin role client-side
    // (e.g. a promoter posting via the public site). Writes go through the
    // server (Firebase Admin SDK) only — no client write rule here.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    // --- products / categories / slides -----------------------------------
    // Public catalog data: anyone can read, only admin/super_admin can write.
    // (No moderator write access here — moderators only touch listings.)
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    match /slides/{slideId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    // --- settings ----------------------------------------------------------
    // Site-wide settings docs (currently: terms & conditions shown at signup).
    // Public read so anyone can view them before agreeing; only admin/super_admin
    // can edit.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    // --- siteVisits ----------------------------------------------------------
    // One doc per calendar day (id "YYYY-MM-DD"), { count: number }. Any visitor
    // (including signed-out ones) can bump today's counter, but the write is
    // constrained to just that one integer field — no arbitrary data. Only
    // staff admins can read the totals (powers the visits report).
    match /siteVisits/{dayId} {
      allow read: if isStaffAdmin();
      allow write: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int;
    }

    // --- users -----------------------------------------------------------
    // Each user can read/write only their own profile document.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- notifications -----------------------------------------------------
    // Each user reads and marks-read only their own notifications. Only a
    // moderator+ can create one — right now that's just "your listing was
    // approved/rejected" from the moderation queue, but this stays open to
    // any future moderation-triggered notification without a rules change.
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if canModerateListings();
    }

    // --- locationNodes -----------------------------------------------------
    // The whole location tree (Division -> District -> Upazila -> Area -> ...,
    // unlimited depth via parentId) lives here — including every built-in
    // division/district/upazila, seeded in by the admin Locations page on
    // first visit (lib/location-nodes.ts). Public read so the post-ad
    // location picker works for everyone; only staff-admin can add, edit, or
    // remove nodes.
    match /locationNodes/{nodeId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    // --- propertyTypeCategories ---------------------------------------------
    // The Rent/Sale category list shown in the Browse Property Types menu,
    // post-ad form, and listings filter (lib/property-type-categories.ts).
    // Public read so every visitor sees the current list; only staff-admin
    // can add, edit, or remove categories.
    match /propertyTypeCategories/{categoryId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    // --- listings ------------------------------------------------------
    // Anyone can read active listings; the owner can read their own listing
    // regardless of status (pending/rejected/sold); staff/moderators can read
    // everything (needed for the moderation queue).
    //
    // New listings always start "pending" — approving/rejecting them is
    // moderator+ only. The owner can edit their own listing but can't
    // self-approve (set status to "active") or self-reject, and can't
    // activate their own boost (that's staff-only, until payment is
    // verified).
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || canModerateListings();

      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if canModerateListings() || (
        isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && (request.resource.data.status == 'pending' || request.resource.data.status == 'sold')
        && (request.resource.data.boost.status != 'active' || resource.data.boost.status == 'active')
      );

      allow delete: if canModerateListings()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // --- buyRequests -------------------------------------------------------
    // The buyer creates the request; buyer and seller can both read it so
    // the seller sees interest and the buyer can see its status.
    match /buyRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;

      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // --- chats ---------------------------------------------------------
    // Only the two participants (buyer + seller) of a chat can read/write
    // it and its messages.
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds;

      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;

        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
